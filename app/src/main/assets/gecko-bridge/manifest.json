{
  "manifest_version": 2,
  "name": "PG Proxy private account session bridge",
  "version": "0.1.0",
  "browser_specific_settings": { "gecko": { "id": "session-bridge@pgproxy.local" } },
  "permissions": ["cookies", "webRequest", "nativeMessaging", "geckoViewAddons", "https://*.google.com/*"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [{
    "matches": ["https://aistudio.google.com/*"],
    "js": ["page-ready.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
